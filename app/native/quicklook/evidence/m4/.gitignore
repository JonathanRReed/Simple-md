# The fixture runner recreates generated files. Keep the final panels and logs.
run-*/fixtures/large.md
run-[12]/*
!run-[12]/runtime.txt
!run-[12]/timings.json
!run-[12]/attribution.json
!run-[12]/cleanup.txt
!run-[12]/flux-before.txt
!run-[12]/flux-after.txt
diagnostic-*/*
!diagnostic-*/runtime.txt
!diagnostic-*/cleanup.txt
!diagnostic-*/flux-before.txt
!diagnostic-*/flux-after.txt
!diagnostic-public-api/public-api.txt
!diagnostic-thumbnail-caps/*.png
